<rml>
<head>
	<link type="text/rcss" href="../rml.rcss"/>
	<style>
	body {
		font-family: LatoLatin;
		font-weight: normal;
		font-style: normal;
		font-size: 11dp;
		width: 100%;
		height: 100%;
		background-color: white;
	}
	
	.background-image{
		position: fixed;
		width: 100%;
		height: 100%;
		top: 0px;
		left: 0px;
	}
	
	.item_parent{
		position: absolute;
        display: flex;
        align-items: center;
        justify-content: center;
        top: 50%;
        left: 50%;
        margin-right: -50%;
        transform: translate(-50%, -50%);
    	text-align: center;
		background-color: rgba(0, 0, 0, 180);
		border-width: 1px;
		border-color: black;
		width: 200px;
		height: 400px;
		border-radius: 1px;
	}
	
	button{
		border-radius: 2px;
		background-color: rgba(255, 255, 255, 50);
		padding: 5px;
	}
	
	
	button:active
	{
		background-color: rgba(255, 255, 255, 150);
	}

	</style>
</head>
<body>

<img class='background-image' src="tales_of_relica.tga"></img>

<div class='item_parent'>
 <button onclick='start sp' id='start_sp_button'>Start Single Player</button>
</div>


</body>
</rml>