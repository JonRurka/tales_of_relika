<rml>
<head>
	<link type="text/rcss" href="../rml.rcss"/>
	<style>
	body {
		font-family: LatoLatin;
		font-weight: normal;
		font-style: normal;
		font-size: 11dp;
		width: 100%;
		height: 100%;
		background-color: black;
	}
	
	.item_parent{
		position: absolute;
        display: flex;
        align-items: center;
        justify-content: center;
        top: 50%;
        left: 50%;
        margin-right: -50%;
        transform: translate(-50%, -50%);
    	text-align: center;
		width: 100px;
		height: 50px;
	}

	</style>
</head>
<body>

<div class='item_parent'>
	<p id='loading_text'>Loading...</p>
</div>


</body>
</rml>